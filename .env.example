# ── Info Kelurahan — contoh konfigurasi ─────────────────────────────
# Salin menjadi .env.local untuk pengembangan lokal.
# Tanpa Supabase, aplikasi otomatis berjalan dalam mode DEMO
# (data awal bawaan + penyimpanan lokal). Dengan Supabase, seluruh
# data disimpan permanen di database Postgres gratis.

# URL publik situs (dipakai untuk metadata, sitemap, dan Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (opsional — gratis) ────────────────────────────────────
# Buat project di https://supabase.com lalu jalankan supabase/schema.sql
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Isi data berita bawaan otomatis bila tabel masih kosong
AUTO_SEED=true

# ── Admin dashboard ─────────────────────────────────────────────────
# Ganti dengan kata sandi rahasia Anda sendiri
ADMIN_PASSWORD=ganti-kata-sandi-ini
# String acak panjang untuk menandatangani cookie sesi admin
ADMIN_SESSION_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter
